# Copy this file to `.env` and edit as needed:
#
#     cp .env.example .env          # Mac / Linux
#     copy .env.example .env        # Windows
#
# `.env` is gitignored and must never be committed. This template is
# committed so everyone knows which variables exist without a real value
# ever reaching the repo.
#
# Every variable below has a working default in the code — an empty `.env`
# is fine. Set them only when you need to override.


# --- local model (agent/llm.py) --------------------------------------

# Which Ollama model the agent talks to.
# The 3B is what all committed results were produced with. The 7B does not
# fit on a 6 GB card; check yours with `nvidia-smi` before changing this.
AGENT_MODEL=qwen2.5-coder:3b

# Where Ollama is listening. Change only if you moved the port or are
# running it on another machine.
OLLAMA_HOST=http://localhost:11434

# Sampling temperature for trajectory generation.
# NOT a free parameter: at 0 every attempt at a question is identical and
# you get one trajectory five times. 0.7 is what produces the variety the
# critic trains on, and it is what the committed trajectories used.
# Changing it makes new runs incomparable with the existing dataset.
AGENT_TEMPERATURE=0.7


# --- keys ------------------------------------------------------------
#
# There are none, and that is deliberate — the agent runs entirely on a
# local model. If a layer later needs a hosted API, add the variable name
# here with an EMPTY value, and put the real key only in your own `.env`.
#
# Example of the right shape:
# OPENAI_API_KEY=
